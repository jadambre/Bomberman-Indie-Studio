# Consistent text across Windows and other development environments.
* text=auto
*.cs text eol=lf
*.shader text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmd text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf

# Large, non-diffable game audio stays in Git LFS.
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Curated documentation images stay in ordinary Git.
*.png binary
*.jpg binary
*.jpeg binary
